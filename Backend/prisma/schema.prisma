// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

model Admin {
  id        String     @id @default(uuid())
  names     String     @unique
  email     String     @unique
  password  String
  isLocked  Boolean    @default(false)
  role      AdminRole  @default(ADMIN) // Default role is ADMIN
  createdAt DateTime   @default(now())
  
  updatedAt DateTime   @updatedAt
}







model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id          String      @id @default(cuid())
  title       String
  description String    @db.Text
  quote       String?
  image       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  replies     BlogReply[] // relation
}

model BlogReply {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  message   String
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id])
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName  String
  lastName  String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}


model Testmonial{
  id        String   @id @default(uuid())
  fullName  String
  profileImage     String?
  position  String
  message   String  @db.Text
  rate     Int @default(0)
  createdAt DateTime @default(now())
}



model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  status        OrderStatus    @default(PENDING)
  totalAmount   Float
  notes         Json?

  // 🔹 Client snapshot
  clientName    String
  clientPhone   String?
  clientEmail   String?

  // 🔹 Relations
  client        Client?        @relation(fields: [clientId], references: [id])
  clientId      String?

  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items         OrderItem[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model OrderItem {
  id          String     @id @default(cuid())
  quantity    Int        @default(1)
  unitPrice   Float
  totalPrice  Float

  // 🔹 Relations
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String

  menuItem    MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId  String

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
}

// 🔹 Enums
enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}




model Company {
  id             String      @id @default(cuid())
  name           String
  email          String?     @unique
  phone          String?
  description    Json?
  logo           String?
  address        String?
  city           String?
  country        String?

  password       String

  type           CompanyType @default(OTHER)
  isActive       Boolean     @default(true)
  
  // Relations
  category MenuCategory[]
 
  orders       Order[]
  items     MenuItem[] // One category can have many items
  employee  Employee[]
  leave  Leave[]
 
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum CompanyType {
  RESTAURANT
  SUPERMARKET
  SHOP
  HOTEL
  BAR
  LOUNGE
  OTHER
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String
  image     String?
  companyId String
  company   Company    @relation(fields: [companyId], references: [id],onDelete: Cascade)
  items     MenuItem[] // One category can have many items
}


model Employee {
  id                      String         @id @unique @default(uuid())
  first_name              String
  last_name               String
  gender                  String
  date_of_birth           DateTime
  phone                   String
  email                   String         @unique
  password                String?
  address                 String
  national_id             String         @unique
  profile_picture         String?
  bank_account_number     String?
  bank_name               String?
  cv                      String?
  application_letter      String?
  identityCardImage      String?

  position                String

  marital_status          MaritalStatus? @default(SINGLE)
  date_hired              DateTime
  status                  EmployeeStatus @default(ACTIVE)
  experience              Json?
  emergency_contact_name  String?
  emergency_contact_phone String?

    company         Company?            @relation(fields: [companyId], references: [id])
  companyId       String?
  // security
  google_id    String?  @unique
  isLocked   Boolean? @default(false)
  is2FA   Boolean? @default(false)
  leave  Leave[]
 
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

}

// Define the enum first
enum EmployeeStatus {
  ACTIVE
  TERMINATED
  RESIGNED
  PROBATION
}

// Enum for marital status
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
  COMPASSIONATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Leave {
  id                 String       @id @default(cuid())
  employee               Employee         @relation(fields: [employeeId], references: [id])
  employeeId             String

  company         Company         @relation(fields: [companyId], references: [id])
  companyId       String

  type               LeaveType
  status             LeaveStatus  @default(PENDING)
  startDate          DateTime
  endDate            DateTime

  // Request info
  reasonForRequest   String?
  attachments        Json?        // JSON array [ { filename, url, mimeType } ]

  // Decision info
  approvedAt         DateTime?
  rejectedAt         DateTime?
  reasonForRejection String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}


model CompanyNotification {
  id          String   @id @default(cuid())
  recipients  Json     // [{id: string, type: "COMPANY" | "EMPLOYEE", read: false}]
  senderId    String?
  senderType  SenderType?
  title       String
  message     String
  link        String?
  createdAt   DateTime @default(now())
}


enum SenderType {
  COMPANY
  EMPLOYEE
}



model MenuItem {
  id              String            @id @default(cuid())
  name            String
  description     String?
  sellingPrice    Float              // Selling price
  purchasingPrice Float?             // Purchase price (for profit margin)
  difference      Float?             // Profit = sellingPrice - purchasingPrice

  mainImage       String?            // Front cover photo
  otherImages     Json?              @default("[]") // Gallery images

   orderItems      OrderItem[]

  purpose         PurposeStatus      @default(EATING)

  // 🔹 Drink-specific fields
  drinkState      DrinkStateStatus?
  alcoholicType   AlcoholicType?     // Type of alcoholic drink if applicable

  // 🔹 Food-specific fields
  ingredients     Json?              // List of ingredients
  recipe          String?            // Preparation or cooking instructions

  discount        Int                @default(0)
  isActive        Boolean            @default(true)

  // 🔹 Relations
  company         Company?            @relation(fields: [companyId], references: [id])
  companyId       String?

  category        MenuCategory?      @relation(fields: [categoryId], references: [id])
  categoryId      String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

enum PurposeStatus {
  EATING
  DRINKING
}

enum DrinkStateStatus {
  ALCOHOLIC
  NON_ALCOHOLIC
}

enum AlcoholicType {
  LIQUOR
  WINE
  BEER
}




model Client {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phoneNumber  String?   
  password     String
  profileImage String?
  status       Status    @default(ACTIVE)
  google_id    String?   
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt


  // Relations

   orders       Order[]   // A user can place multiple orders
  
  @@index([email])
  @@index([name])
}

enum Status {
  ACTIVE
  INACTIVE
}
